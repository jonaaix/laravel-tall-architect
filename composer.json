{
   "version": "1.3.3",
   "name": "aaix/laravel-tall-architect",
   "description": "Distributes and maintains the aaix TALL stack AI agent rules and guidelines across Laravel projects via Laravel Boost.",
   "type": "laravel-package",
   "keywords": [
      "laravel",
      "boost",
      "ai",
      "guidelines",
      "tall"
   ],
   "license": "MIT",
   "authors": [
      {
         "name": "Jonas Gnioui",
         "email": "jonaaix@icloud.com"
      }
   ],
   "require": {
      "php": "^8.2",
      "illuminate/console": ">=12.0.0",
      "illuminate/filesystem": ">=12.0.0",
      "illuminate/support": ">=12.0.0"
   },
   "require-dev": {
      "roave/security-advisories": "dev-latest",
      "laravel/boost": ">=2.4.0",
      "orchestra/testbench": ">=10.0.0",
      "phpunit/phpunit": ">=11.0.0"
   },
   "suggest": {
      "laravel/boost": "Required to compose the guidelines into your agent files (AGENTS.md, CLAUDE.md, ...)."
   },
   "autoload": {
      "psr-4": {
         "Aaix\\LaravelTallArchitect\\": "src/"
      }
   },
   "autoload-dev": {
      "psr-4": {
         "Aaix\\LaravelTallArchitect\\Tests\\": "tests/"
      }
   },
   "extra": {
      "laravel": {
         "providers": [
            "Aaix\\LaravelTallArchitect\\TallArchitectServiceProvider"
         ]
      }
   },
   "scripts": {
      "test": "vendor/bin/phpunit --colors=always --testdox",
      "test-coverage": "vendor/bin/phpunit --coverage-html coverage"
   },
   "config": {
      "sort-packages": true,
      "allow-plugins": {
         "php-http/discovery": true
      }
   },
   "minimum-stability": "dev",
   "prefer-stable": true
}
